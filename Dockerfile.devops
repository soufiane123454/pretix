
# 1. Image de base
FROM python:3.13-trixie

# 2. Variables d'environnement
ENV LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    DJANGO_SETTINGS_MODULE=production_settings \
    DATA_DIR=/data/ \
    HOME=/pretix \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 3. Installation de Node.js 22
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update

# 4. Installation des dépendances système
RUN apt-get install -y --no-install-recommends \
    build-essential \
    gettext \
    git \
    libffi-dev \
    libjpeg-dev \
    libmemcached-dev \
    libpq-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    locales \
    python3-dev \
    sudo \
    libmaxminddb0 \
    libmaxminddb-dev \
    zlib1g-dev \
    nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen C.UTF-8 \
    && /usr/sbin/update-locale LANG=C.UTF-8

# 5. Création de l'utilisateur et des répertoires
RUN mkdir -p /etc/pretix /data /static \
    && useradd -ms /bin/bash -d /pretix -u 15371 pretixuser \
    && chmod 0755 /pretix

# 6. Répertoire de travail
WORKDIR /pretix

# 7. Copie des fichiers nécessaires à l'installation Python
COPY pyproject.toml ./
COPY _build ./_build

# 8. Copie des fichiers frontend
COPY package.json package-lock.json ./
COPY tsconfig.json vite.config.ts ./

# 9. Copie du code source
COPY src ./src

# 10. Configuration Django de production
COPY deployment/docker/production_settings.py ./src/production_settings.py

# 11. Installation des dépendances Python
RUN pip install --upgrade pip setuptools \
    && PRETIX_DOCKER_BUILD=TRUE pip install -e ".[memcached]" \
       gunicorn django-extensions ipython

# 12. Préparation des permissions
RUN mkdir -p /data/logs /data/media \
    && chown -R pretixuser:pretixuser /pretix /data /static

# 13. Préparation de l'application pour la production
WORKDIR /pretix/src

RUN sudo -u pretixuser make production

# 14. Port d'écoute de Gunicorn
EXPOSE 8000

# 15. Utilisateur d'exécution
USER pretixuser

# 16. Commande de démarrage par défaut
CMD ["gunicorn", "pretix.wsgi", "--bind=0.0.0.0:8000", "--workers=3", "--max-requests=1200", "--max-requests-jitter=50", "--log-level=info"]
